<Window x:Class="MAS.WinUI.InstrumentConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="连接"
        Width="465"
        Height="545"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFFFFF">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#2EA43A">
            <Grid Margin="18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔌" FontSize="20" Foreground="White" Margin="0,0,12,0" />
                    <TextBlock Text="连接" FontSize="18" FontWeight="SemiBold" Foreground="White" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,20,28,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="选择蓝牙设备" FontSize="13" FontWeight="SemiBold" Foreground="#6B7280" Margin="4,0,0,12" />

            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="74" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="PortComboBox"
                          Height="42"
                          VerticalContentAlignment="Center"
                          SelectionChanged="PortComboBox_OnSelectionChanged"
                          DisplayMemberPath="DisplayName" />
                <Button Grid.Column="1"
                        Margin="10,0,0,0"
                        Height="42"
                        Background="#FFFFFF"
                        BorderBrush="#D1D5DB"
                        Click="ScanButton_OnClick">
                    <TextBlock Text="搜索" Foreground="#6B7280" FontWeight="SemiBold" />
                </Button>
            </Grid>

            <Border Grid.Row="2" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8" Background="#FFFFFF">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="StatusTextBlock" Text="请选择 COM 口并搜索蓝牙设备。" Foreground="#6B7280" Margin="2,0,0,10" />
                    <ListBox x:Name="BluetoothDeviceListBox"
                             Grid.Row="1"
                             BorderThickness="0"
                             Background="#FFFFFF"
                             DisplayMemberPath="FriendlyName" />
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="156" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="126" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1"
                        x:Name="ConfirmButton"
                        Content="连接"
                        Height="48"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Background="#F3F4F6"
                        Foreground="#94A3B8"
                        BorderBrush="#E5E7EB"
                        Click="ConfirmButton_OnClick" />
                <Button Grid.Column="3"
                        Content="关闭"
                        Height="48"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Background="#FFFFFF"
                        Foreground="#374151"
                        BorderBrush="#D1D5DB"
                        Click="CloseButton_OnClick" />
            </Grid>
        </Grid>
    </Grid>
</Window>
