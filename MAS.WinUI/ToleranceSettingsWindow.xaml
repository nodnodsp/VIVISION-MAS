<Window x:Class="MAS.WinUI.ToleranceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="容差设置"
        Width="580"
        Height="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFFFFF">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#2EA43A">
            <Grid Margin="18,0">
                <TextBlock Text="容差设置" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="8,14,8,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="74" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="容差类型" VerticalAlignment="Center" Margin="6,0,8,0" />
                <ComboBox x:Name="ToleranceTypeComboBox" Grid.Column="1" Height="34" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="ΔE*" />
                </ComboBox>
            </Grid>

            <TabControl Grid.Row="1" x:Name="ToleranceTabControl">
                <TabItem Header="颜色容差">
                    <DataGrid x:Name="ColorToleranceGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              Margin="8"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="角度" Binding="{Binding AngleCode}" Width="180" IsReadOnly="True" />
                            <DataGridTextColumn Header="最小值" Binding="{Binding MinValue}" Width="110" />
                            <DataGridTextColumn Header="最大值" Binding="{Binding MaxValue}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="闪烁度容差">
                    <DataGrid x:Name="SparkleToleranceGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              Margin="8"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="角度" Binding="{Binding AngleCode}" Width="180" IsReadOnly="True" />
                            <DataGridTextColumn Header="最小值" Binding="{Binding MinValue}" Width="110" />
                            <DataGridTextColumn Header="最大值" Binding="{Binding MaxValue}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="综合色差">
                    <DataGrid x:Name="OverallToleranceGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              Margin="8"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="项目" Binding="{Binding AngleCode}" Width="180" IsReadOnly="True" />
                            <DataGridTextColumn Header="最小值" Binding="{Binding MinValue}" Width="110" />
                            <DataGridTextColumn Header="最大值" Binding="{Binding MaxValue}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="96" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="接受" Height="40" Background="#FFFFFF" BorderBrush="#D1D5DB" Click="AcceptButton_OnClick" />
                <Button Grid.Column="3" Content="取消" Height="40" Background="#FFFFFF" BorderBrush="#D1D5DB" Click="CancelButton_OnClick" />
            </Grid>
        </Grid>
    </Grid>
</Window>
