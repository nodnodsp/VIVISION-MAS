<Window x:Class="MAS.WinUI.LightSourceObserverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="光源设置"
        Width="380"
        Height="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFFFFF">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#2EA43A">
            <Grid Margin="18,0">
                <TextBlock Text="光源设置" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,24,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="光源" Grid.Row="0" VerticalAlignment="Center" FontSize="15" />
            <ComboBox x:Name="LightSourceComboBox" Grid.Row="0" Grid.Column="1" Height="40" VerticalContentAlignment="Center" />

            <TextBlock Text="观察者" Grid.Row="1" Margin="0,14,0,0" VerticalAlignment="Center" FontSize="15" />
            <ComboBox x:Name="ObserverComboBox" Grid.Row="1" Grid.Column="1" Margin="0,14,0,0" Height="40" VerticalContentAlignment="Center" />

            <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="94" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="94" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="接受" Height="42" Background="#FFFFFF" BorderBrush="#D1D5DB" Click="AcceptButton_OnClick" />
                <Button Grid.Column="3" Content="取消" Height="42" Background="#FFFFFF" BorderBrush="#D1D5DB" Click="CancelButton_OnClick" />
            </Grid>
        </Grid>
    </Grid>
</Window>
