                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="1" Margin="0,0,0,18" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>
                <Border Margin="0,0,12,0" Background="#101B33" CornerRadius="20" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel Margin="22">
                        <TextBlock Text="快速操作" Foreground="White" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="先完成数据库和主数据初始化，再逐步接真实设备与测量流程。" Foreground="#94A3B8" FontSize="14" Margin="0,8,0,18" />
                        <WrapPanel>
                            <Button Content="初始化数据库" Width="148" Height="44" Margin="0,0,12,12" Background="#14B8A6" Foreground="White" BorderBrush="#14B8A6" Click="InitializeDatabaseButton_OnClick" />
                            <Button Content="生成任务草稿" Width="148" Height="44" Margin="0,0,12,12" Background="#0EA5E9" Foreground="White" BorderBrush="#0EA5E9" Click="CreateDraftTaskButton_OnClick" />
                            <Button Content="标准样测量" Width="148" Height="44" Margin="0,0,12,12" Background="#22C55E" Foreground="White" BorderBrush="#22C55E" Click="ExecuteStandardMeasurementButton_OnClick" />
                            <Button Content="试样测量" Width="148" Height="44" Margin="0,0,12,12" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" Click="ExecuteTrialMeasurementButton_OnClick" />
                            <Button Content="导出报告" Width="148" Height="44" Margin="0,0,12,12" Background="#F97316" Foreground="White" BorderBrush="#F97316" Click="ExportReportButton_OnClick" />
