                            <TextBox x:Name="TaskFilterCodeTextBox" Width="140" Margin="0,0,10,0" />
                            <TextBlock Text="状态" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="TaskFilterStatusComboBox" Width="110" SelectedIndex="0" Margin="0,0,10,0">
                                <ComboBoxItem Content="全部" />
                                <ComboBoxItem Content="Draft" />
                                <ComboBoxItem Content="Running" />
                                <ComboBoxItem Content="Completed" />
                                <ComboBoxItem Content="Failed" />
                            </ComboBox>
                            <Button Content="筛选任务" Width="90" Height="34" Margin="0,0,10,0" Background="#475569" Foreground="White" BorderBrush="#475569" Click="ApplyTaskFilterButton_OnClick" />
