                                    <TextBlock x:Name="TemplateSummaryTextBlock" Text="请选择一条模板查看摘要。" Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <TextBlock x:Name="TemplateUsageTextBlock" Text="-" Foreground="#94A3B8" TextWrapping="Wrap" />
                                </StackPanel>
                            </GroupBox>
                            <DataGrid x:Name="TemplateGrid"
