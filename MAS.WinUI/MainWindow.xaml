                                <Button Content="保存模板" Width="140" Height="40" Margin="0,0,10,0" Background="#14B8A6" Foreground="White" BorderBrush="#14B8A6" Click="SaveTemplateButton_OnClick" />
                                <Button Content="清空表单" Width="100" Height="40" Background="#334155" Foreground="White" BorderBrush="#334155" Click="ClearTemplateInputsButton_OnClick" />
                            </WrapPanel>
