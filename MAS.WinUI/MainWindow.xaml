                            <ColumnDefinition Width="340" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="新增标准样" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
