                <TabItem Header="模板管理">
                    <Grid Margin="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="新增容差模板" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <TextBlock Text="模板编号" Margin="0,6,0,4" />
                            <TextBox x:Name="TemplateCodeTextBox" />
                            <TextBlock Text="模板名称" Margin="0,10,0,4" />
                            <TextBox x:Name="TemplateNameTextBox" />
                            <TextBlock Text="色差公式" Margin="0,10,0,4" />
                            <TextBox x:Name="TemplateFormulaTextBox" Text="DE00" />
                            <TextBlock Text="综合色差上限" Margin="0,10,0,4" />
                            <TextBox x:Name="TemplateOverallLimitTextBox" Text="1.0" />
                            <TextBlock Text="效果差上限" Margin="0,10,0,4" />
                            <TextBox x:Name="TemplateEffectLimitTextBox" Text="1.0" />
