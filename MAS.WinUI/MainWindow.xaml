<Window x:Class="MAS.WinUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MAS V1 多角度测色仪工作台"
        Height="940"
        Width="1480"
        MinWidth="1280"
        MinHeight="820"
        Loaded="MainWindow_OnLoaded"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#0B1225">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="MAS V1 多角度测色仪工作台" Foreground="White" FontSize="26" FontWeight="Bold" />
                    <TextBlock Text="1.0 开发版 / WPF + .NET 8 / SQLite" Foreground="#93C5FD" FontSize="13" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="环境状态：" Foreground="#CBD5E1" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <Border Background="#14532D" CornerRadius="10" Padding="10,4">
                        <TextBlock Text="已就绪" Foreground="White" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Margin="18" Background="#0B1225" CornerRadius="20" BorderBrush="#1E293B" BorderThickness="1">
            <StackPanel Margin="18">
                <TextBlock Text="导航" Foreground="#38BDF8" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16" />
                <Border Background="#0F766E" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                    <TextBlock Text="首页总览" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                </Border>
                <TextBlock Text="仪器连接" Foreground="#E2E8F0" FontSize="16" Margin="14,10,0,0" />
                <TextBlock Text="测量中心" Foreground="#E2E8F0" FontSize="16" Margin="14,16,0,0" />
                <TextBlock Text="结果分析" Foreground="#E2E8F0" FontSize="16" Margin="14,16,0,0" />
                <TextBlock Text="样品管理" Foreground="#E2E8F0" FontSize="16" Margin="14,16,0,0" />
                <TextBlock Text="颜色库" Foreground="#E2E8F0" FontSize="16" Margin="14,16,0,0" />
                <TextBlock Text="容差设置" Foreground="#E2E8F0" FontSize="16" Margin="14,16,0,0" />
                <TextBlock Text="报告中心" Foreground="#E2E8F0" FontSize="16" Margin="14,16,0,0" />
                <TextBlock Text="系统设置" Foreground="#E2E8F0" FontSize="16" Margin="14,16,0,0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Margin="0,18,18,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="168" />
                <RowDefinition Height="220" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="180" />
            </Grid.RowDefinitions>

            <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,18">
                <Border Margin="0,0,12,0" Background="#13233D" CornerRadius="20" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel Margin="20">
                        <TextBlock Text="设备状态" Foreground="#93C5FD" FontSize="15" />
                        <TextBlock x:Name="DashboardInstrumentStatusText" Text="未连接" Foreground="White" FontSize="34" FontWeight="Bold" Margin="0,18,0,6" />
                        <TextBlock x:Name="DashboardInstrumentDetailText" Text="等待连接真实仪器" Foreground="#CBD5E1" FontSize="14" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,12,0" Background="#13233D" CornerRadius="20" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel Margin="20">
                        <TextBlock Text="数据库状态" Foreground="#93C5FD" FontSize="15" />
                        <TextBlock x:Name="DatabaseStatusText" Text="未初始化" Foreground="White" FontSize="34" FontWeight="Bold" Margin="0,18,0,6" />
                        <TextBlock x:Name="DatabasePathText" Text="Data\MASQC.db" Foreground="#CBD5E1" FontSize="14" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,12,0" Background="#13233D" CornerRadius="20" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel Margin="20">
                        <TextBlock Text="当前任务" Foreground="#93C5FD" FontSize="15" />
                        <TextBlock x:Name="TaskCodeText" Text="未创建" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,18,0,6" />
                        <TextBlock x:Name="TaskStatusText" Text="选中样品后可生成任务草稿" Foreground="#CBD5E1" FontSize="14" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Background="#13233D" CornerRadius="20" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel Margin="20">
                        <TextBlock Text="任务与报告" Foreground="#93C5FD" FontSize="15" />
                        <TextBlock x:Name="DashboardTaskCountText" Text="0 / 0" Foreground="White" FontSize="34" FontWeight="Bold" Margin="0,18,0,6" />
                        <TextBlock x:Name="DashboardTaskReportDetailText" Text="暂无任务与报告数据" Foreground="#CBD5E1" FontSize="14" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>
                <Border Margin="0,0,12,0" Background="#101B33" CornerRadius="20" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel Margin="22">
                        <TextBlock Text="快速操作" Foreground="White" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="先完成数据库和主数据初始化，再逐步接真实设备与测量流程。" Foreground="#94A3B8" FontSize="14" Margin="0,8,0,18" />
                        <WrapPanel>
                            <Button x:Name="InitializeDatabaseButton" Content="初始化数据库" Width="148" Height="44" Margin="0,0,12,12" Background="#14B8A6" Foreground="White" BorderBrush="#14B8A6" Click="InitializeDatabaseButton_OnClick" />
                            <Button Content="生成任务草稿" Width="148" Height="44" Margin="0,0,12,12" Background="#0EA5E9" Foreground="White" BorderBrush="#0EA5E9" Click="CreateDraftTaskButton_OnClick" />
                            <Button Content="标准样测量" Width="148" Height="44" Margin="0,0,12,12" Background="#22C55E" Foreground="White" BorderBrush="#22C55E" Click="ExecuteStandardMeasurementButton_OnClick" />
                            <Button Content="试样测量" Width="148" Height="44" Margin="0,0,12,12" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" Click="ExecuteTrialMeasurementButton_OnClick" />
                            <Button Content="导出报告" Width="148" Height="44" Margin="0,0,12,12" Background="#F97316" Foreground="White" BorderBrush="#F97316" Click="ExportReportButton_OnClick" />
                            <Button Content="刷新主数据" Width="148" Height="44" Margin="0,0,12,12" Background="#475569" Foreground="White" BorderBrush="#475569" Click="RefreshDataButton_OnClick" />
                            <Button Content="查看建表脚本" Width="148" Height="44" Margin="0,0,12,12" Background="#F59E0B" Foreground="White" BorderBrush="#F59E0B" Click="OpenSchemaButton_OnClick" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#101B33" CornerRadius="20" BorderBrush="#334155" BorderThickness="1">
                    <StackPanel Margin="22">
                        <TextBlock Text="开发备注" Foreground="White" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock x:Name="DashboardRecentActivityText" Text="当前已支持试样、标准样、容差模板、任务草稿、测量记录、角度结果和效果结果写入 SQLite。" Foreground="#94A3B8" FontSize="14" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <TabControl Grid.Row="2" Margin="0,0,0,18" Background="#101B33" BorderBrush="#334155" Foreground="White">
                <TabItem Header="仪器连接">
                    <Grid Margin="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="设备接入" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <TextBlock Text="当前仪器" Margin="0,6,0,4" />
                            <TextBox x:Name="InstrumentNameTextBox" IsReadOnly="True" />
                            <TextBlock Text="型号" Margin="0,10,0,4" />
                            <TextBox x:Name="InstrumentModelTextBox" IsReadOnly="True" />
                            <TextBlock Text="连接方式" Margin="0,10,0,4" />
                            <TextBox x:Name="InstrumentConnectionTypeTextBox" IsReadOnly="True" />
                            <TextBlock Text="端口" Margin="0,10,0,4" />
                            <TextBox x:Name="InstrumentPortTextBox" IsReadOnly="True" />
                            <TextBlock Text="状态" Margin="0,10,0,4" />
                            <TextBox x:Name="InstrumentStatusTextBox" IsReadOnly="True" />
                            <WrapPanel Margin="0,18,0,0">
                                <Button Content="连接仪器" Width="96" Height="40" Margin="0,0,10,10" Background="#22C55E" Foreground="White" BorderBrush="#22C55E" Click="ConnectInstrumentButton_OnClick" />
                                <Button Content="断开连接" Width="96" Height="40" Margin="0,0,10,10" Background="#475569" Foreground="White" BorderBrush="#475569" Click="DisconnectInstrumentButton_OnClick" />
                                <Button Content="白板校准" Width="96" Height="40" Margin="0,0,10,10" Background="#0EA5E9" Foreground="White" BorderBrush="#0EA5E9" Click="WhiteCalibrationButton_OnClick" />
                                <Button Content="黑腔校准" Width="96" Height="40" Margin="0,0,10,10" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" Click="BlackCalibrationButton_OnClick" />
                            </WrapPanel>
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1.2*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DataGrid x:Name="InstrumentGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Background="#0F172A"
                                      Foreground="White"
                                      BorderBrush="#334155"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      SelectionChanged="InstrumentGrid_OnSelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="编号" Binding="{Binding InstrumentCode}" Width="140" />
                                    <DataGridTextColumn Header="名称" Binding="{Binding InstrumentName}" Width="180" />
                                    <DataGridTextColumn Header="型号" Binding="{Binding Model}" Width="120" />
                                    <DataGridTextColumn Header="连接方式" Binding="{Binding ConnectionType}" Width="100" />
                                    <DataGridTextColumn Header="端口" Binding="{Binding PortName}" Width="100" />
                                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <DataGrid x:Name="CalibrationRecordGrid"
                                      Grid.Row="1"
                                      Margin="0,18,0,0"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Background="#0F172A"
                                      Foreground="White"
                                      BorderBrush="#334155"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="校准类型" Binding="{Binding CalibrationType}" Width="120" />
                                    <DataGridTextColumn Header="结果" Binding="{Binding ResultCode}" Width="90" />
                                    <DataGridTextColumn Header="开始时间" Binding="{Binding StartedAt}" Width="180" />
                                    <DataGridTextColumn Header="完成时间" Binding="{Binding FinishedAt}" Width="180" />
                                    <DataGridTextColumn Header="到期时间" Binding="{Binding ExpiresAt}" Width="180" />
                                    <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="220" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="样品管理">
                    <Grid Margin="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="新增试样" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <TextBlock Text="样品编号" Margin="0,6,0,4" />
                            <TextBox x:Name="SampleCodeTextBox" />
                            <TextBlock Text="样品名称" Margin="0,10,0,4" />
                            <TextBox x:Name="SampleNameTextBox" />
                            <TextBlock Text="批次" Margin="0,10,0,4" />
                            <TextBox x:Name="SampleBatchTextBox" />
                            <TextBlock Text="材质" Margin="0,10,0,4" />
                            <TextBox x:Name="SampleMaterialTextBox" />
                            <TextBlock Text="颜色名称" Margin="0,10,0,4" />
                            <TextBox x:Name="SampleColorTextBox" />
                            <WrapPanel Margin="0,18,0,0">
                                <Button Content="保存试样" Width="140" Height="40" Margin="0,0,10,0" Background="#14B8A6" Foreground="White" BorderBrush="#14B8A6" Click="SaveSampleButton_OnClick" />
                                <Button Content="清空表单" Width="100" Height="40" Background="#334155" Foreground="White" BorderBrush="#334155" Click="ClearSampleInputsButton_OnClick" />
                            </WrapPanel>
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <GroupBox Header="试样摘要" Foreground="White" BorderBrush="#334155" Margin="0,0,0,16">
                                <StackPanel Margin="12">
                                    <TextBlock x:Name="SampleSummaryTextBlock" Text="请选择一条试样查看摘要。" Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <TextBlock x:Name="SampleUsageTextBlock" Text="-" Foreground="#94A3B8" TextWrapping="Wrap" />
                                </StackPanel>
                            </GroupBox>
                            <DataGrid x:Name="SampleGrid"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Background="#0F172A"
                                      Foreground="White"
                                      BorderBrush="#334155"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      SelectionChanged="SampleGrid_OnSelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="编号" Binding="{Binding SampleCode}" Width="160" />
                                    <DataGridTextColumn Header="名称" Binding="{Binding SampleName}" Width="180" />
                                    <DataGridTextColumn Header="批次" Binding="{Binding BatchNo}" Width="160" />
                                    <DataGridTextColumn Header="材质" Binding="{Binding MaterialName}" Width="180" />
                                    <DataGridTextColumn Header="颜色" Binding="{Binding ColorName}" Width="140" />
                                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="标准样管理">
                    <Grid Margin="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="新增标准样" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <TextBlock Text="标准样编号" Margin="0,6,0,4" />
                            <TextBox x:Name="StandardCodeTextBox" />
                            <TextBlock Text="标准样名称" Margin="0,10,0,4" />
                            <TextBox x:Name="StandardNameTextBox" />
                            <TextBlock Text="材质" Margin="0,10,0,4" />
                            <TextBox x:Name="StandardMaterialTextBox" />
                            <TextBlock Text="颜色名称" Margin="0,10,0,4" />
                            <TextBox x:Name="StandardColorTextBox" />
                            <TextBlock Text="模板编号" Margin="0,10,0,4" />
                            <TextBox x:Name="StandardTemplateCodeTextBox" Text="TPL-DEFAULT" />
                            <WrapPanel Margin="0,18,0,0">
                                <Button Content="保存标准样" Width="140" Height="40" Margin="0,0,10,0" Background="#14B8A6" Foreground="White" BorderBrush="#14B8A6" Click="SaveStandardSampleButton_OnClick" />
                                <Button Content="清空表单" Width="100" Height="40" Background="#334155" Foreground="White" BorderBrush="#334155" Click="ClearStandardInputsButton_OnClick" />
                            </WrapPanel>
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <GroupBox Header="标准样摘要" Foreground="White" BorderBrush="#334155" Margin="0,0,0,16">
                                <StackPanel Margin="12">
                                    <TextBlock x:Name="StandardSummaryTextBlock" Text="请选择一条标准样查看摘要。" Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <TextBlock x:Name="StandardUsageTextBlock" Text="-" Foreground="#94A3B8" TextWrapping="Wrap" />
                                </StackPanel>
                            </GroupBox>
                            <DataGrid x:Name="StandardSampleGrid"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Background="#0F172A"
                                      Foreground="White"
                                      BorderBrush="#334155"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      SelectionChanged="StandardSampleGrid_OnSelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="编号" Binding="{Binding StandardCode}" Width="160" />
                                    <DataGridTextColumn Header="名称" Binding="{Binding StandardName}" Width="180" />
                                    <DataGridTextColumn Header="材质" Binding="{Binding MaterialName}" Width="180" />
                                    <DataGridTextColumn Header="颜色" Binding="{Binding ColorName}" Width="140" />
                                    <DataGridTextColumn Header="版本" Binding="{Binding VersionNo}" Width="80" />
                                    <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsActive}" Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="模板管理">
                    <Grid Margin="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="新增容差模板" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <TextBlock Text="模板编号" Margin="0,6,0,4" />
                            <TextBox x:Name="TemplateCodeTextBox" />
                            <TextBlock Text="模板名称" Margin="0,10,0,4" />
                            <TextBox x:Name="TemplateNameTextBox" />
                            <TextBlock Text="色差公式" Margin="0,10,0,4" />
                            <TextBox x:Name="TemplateFormulaTextBox" Text="DE00" />
                            <TextBlock Text="综合色差上限" Margin="0,10,0,4" />
                            <TextBox x:Name="TemplateOverallLimitTextBox" Text="1.0" />
                            <TextBlock Text="效果差上限" Margin="0,10,0,4" />
                            <TextBox x:Name="TemplateEffectLimitTextBox" Text="1.0" />
                            <WrapPanel Margin="0,18,0,0">
                                <Button Content="保存模板" Width="140" Height="40" Margin="0,0,10,0" Background="#14B8A6" Foreground="White" BorderBrush="#14B8A6" Click="SaveTemplateButton_OnClick" />
                                <Button Content="清空表单" Width="100" Height="40" Background="#334155" Foreground="White" BorderBrush="#334155" Click="ClearTemplateInputsButton_OnClick" />
                            </WrapPanel>
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <GroupBox Header="模板摘要" Foreground="White" BorderBrush="#334155" Margin="0,0,0,16">
                                <StackPanel Margin="12">
                                    <TextBlock x:Name="TemplateSummaryTextBlock" Text="请选择一条模板查看摘要。" Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <TextBlock x:Name="TemplateUsageTextBlock" Text="-" Foreground="#94A3B8" TextWrapping="Wrap" />
                                </StackPanel>
                            </GroupBox>
                            <DataGrid x:Name="TemplateGrid"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Background="#0F172A"
                                      Foreground="White"
                                      BorderBrush="#334155"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      SelectionChanged="TemplateGrid_OnSelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="编号" Binding="{Binding TemplateCode}" Width="160" />
                                    <DataGridTextColumn Header="名称" Binding="{Binding TemplateName}" Width="180" />
                                    <DataGridTextColumn Header="公式" Binding="{Binding DeltaEFormula}" Width="100" />
                                    <DataGridTextColumn Header="综合色差上限" Binding="{Binding OverallUpperLimit}" Width="120" />
                                    <DataGridTextColumn Header="效果上限" Binding="{Binding EffectUpperLimit}" Width="120" />
                                    <DataGridCheckBoxColumn Header="默认" Binding="{Binding IsDefault}" Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="任务草稿">
                    <Grid Margin="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="新建任务草稿" Width="130" Height="40" Margin="0,0,10,0" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" Click="CreateDraftTaskButton_OnClick" />
                            <Button Content="刷新任务列表" Width="130" Height="40" Margin="0,0,10,0" Background="#475569" Foreground="White" BorderBrush="#475569" Click="RefreshDataButton_OnClick" />
                            <TextBlock Text="用于查看当前测量任务、状态流转和绑定信息。" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </WrapPanel>
                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="0.9*" />
                            </Grid.ColumnDefinitions>
                            <GroupBox Header="任务概览" Margin="0,0,9,0" Foreground="White" BorderBrush="#334155">
                                <StackPanel Margin="12">
                                    <TextBlock x:Name="TaskSummaryTextBlock" Text="请选择任务查看概览。" Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <TextBlock x:Name="TaskMetricTextBlock" Text="-" Foreground="#94A3B8" TextWrapping="Wrap" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Grid.Column="1" Header="最近活动" Margin="9,0,0,0" Foreground="White" BorderBrush="#334155">
                                <StackPanel Margin="12">
                                    <TextBlock x:Name="TaskRecentActivityTextBlock" Text="暂无最近活动。" Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <TextBlock x:Name="TaskRecentReportTextBlock" Text="-" Foreground="#94A3B8" TextWrapping="Wrap" />
                                </StackPanel>
                            </GroupBox>
                        </Grid>
                        <DataGrid x:Name="TaskGrid"
                                  Grid.Row="2"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Background="#0F172A"
                                  Foreground="White"
                                  BorderBrush="#334155"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  SelectionChanged="TaskGrid_OnSelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="任务编号" Binding="{Binding TaskCode}" Width="220" />
                                <DataGridTextColumn Header="仪器ID" Binding="{Binding InstrumentId}" Width="140" />
                                <DataGridTextColumn Header="试样ID" Binding="{Binding SampleId}" Width="220" />
                                <DataGridTextColumn Header="标准样ID" Binding="{Binding StandardSampleId}" Width="220" />
                                <DataGridTextColumn Header="模板ID" Binding="{Binding TemplateId}" Width="220" />
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
<TabItem Header="测量记录">
                    <Grid Margin="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,18,0">
                            <StackPanel>
                                <TextBlock Text="测量流程" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <TextBlock Text="任务编号" Margin="0,6,0,4" />
                                <TextBox x:Name="RecordTaskCodeTextBox" />
                                <TextBlock Text="记录序号" Margin="0,10,0,4" />
                                <TextBox x:Name="RecordNoTextBox" Text="1" />
                                <TextBlock Text="记录类型" Margin="0,10,0,4" />
                                <TextBox x:Name="RecordTypeTextBox" Text="trial" />
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="执行标准样测量" Width="150" Height="40" Margin="0,0,10,10" Background="#22C55E" Foreground="White" BorderBrush="#22C55E" Click="ExecuteStandardMeasurementButton_OnClick" />
                                    <Button Content="执行试样测量" Width="150" Height="40" Margin="0,0,10,10" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" Click="ExecuteTrialMeasurementButton_OnClick" />
                                </WrapPanel>
                                <TextBlock Text="也可使用下面表单进行手工补录。" Foreground="#94A3B8" Margin="0,2,0,8" TextWrapping="Wrap" />
                                <TextBlock Text="综合色差" Margin="0,10,0,4" />
                                <TextBox x:Name="RecordTotalDeltaETextBox" Text="0.68" />
                                <TextBlock Text="效果差" Margin="0,10,0,4" />
                                <TextBox x:Name="RecordTotalEffectDiffTextBox" Text="0.32" />
                                <TextBlock Text="判定结果" Margin="0,10,0,4" />
                                <ComboBox x:Name="RecordPassStatusComboBox" SelectedIndex="0">
                                    <ComboBoxItem Content="Pass" />
                                    <ComboBoxItem Content="Warning" />
                                    <ComboBoxItem Content="Fail" />
                                </ComboBox>
                                <TextBlock Text="摘要说明" Margin="0,10,0,4" />
                                <TextBox x:Name="RecordSummaryTextBox" Text="测量结果处于容差范围内。" TextWrapping="Wrap" AcceptsReturn="True" Height="60" />

                                <Separator Margin="0,16,0,16" />
                                <TextBlock Text="角度结果" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="角度代码" Margin="0,10,0,4" />
                                <TextBox x:Name="RecordAngleCodeTextBox" Text="45as110" />
                                <TextBlock Text="L*" Margin="0,10,0,4" />
                                <TextBox x:Name="RecordCieLTextBox" Text="63.14" />
                                <TextBlock Text="a*" Margin="0,10,0,4" />
                                <TextBox x:Name="RecordCieATextBox" Text="-1.04" />
                                <TextBlock Text="b*" Margin="0,10,0,4" />
                                <TextBox x:Name="RecordCieBTextBox" Text="-3.18" />
                                <TextBlock Text="角度色差 ΔE" Margin="0,10,0,4" />
                                <TextBox x:Name="RecordAngleDeltaETextBox" Text="0.81" />

                                <Separator Margin="0,16,0,16" />
                                <TextBlock Text="效果结果" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Sparkle" Margin="0,10,0,4" />
                                <TextBox x:Name="RecordSparkleValueTextBox" Text="4.12" />
                                <TextBlock Text="Sparkle 差值" Margin="0,10,0,4" />
                                <TextBox x:Name="RecordSparkleDiffTextBox" Text="0.18" />
                                <TextBlock Text="Graininess" Margin="0,10,0,4" />
                                <TextBox x:Name="RecordGraininessValueTextBox" Text="2.06" />
                                <TextBlock Text="Graininess 差值" Margin="0,10,0,4" />
                                <TextBox x:Name="RecordGraininessDiffTextBox" Text="0.14" />
                                <WrapPanel Margin="0,18,0,0">
                                    <Button Content="保存手工记录" Width="150" Height="40" Margin="0,0,10,10" Background="#14B8A6" Foreground="White" BorderBrush="#14B8A6" Click="SaveMeasurementRecordButton_OnClick" />
                                    <Button Content="导出当前报告" Width="150" Height="40" Margin="0,0,10,10" Background="#F97316" Foreground="White" BorderBrush="#F97316" Click="ExportReportButton_OnClick" />
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1.55*" />
                                <RowDefinition Height="1.05*" />
                            </Grid.RowDefinitions>

                            <WrapPanel Margin="0,0,0,12">
                                <TextBlock Text="任务编号" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="RecordFilterTaskCodeTextBox" Width="140" Margin="0,0,10,0" />
                                <TextBlock Text="记录类型" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="RecordFilterTypeComboBox" Width="110" SelectedIndex="0" Margin="0,0,10,0">
                                    <ComboBoxItem Content="全部" />
                                    <ComboBoxItem Content="standard" />
                                    <ComboBoxItem Content="trial" />
                                </ComboBox>
                                <Button Content="筛选记录" Width="90" Height="34" Margin="0,0,10,0" Background="#475569" Foreground="White" BorderBrush="#475569" Click="ApplyRecordFilterButton_OnClick" />
                                <Button Content="清空" Width="70" Height="34" Background="#334155" Foreground="White" BorderBrush="#334155" Click="ClearRecordFilterButton_OnClick" />
                            </WrapPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <GroupBox Header="任务上下文" Margin="0,0,9,0" Foreground="White" BorderBrush="#334155">
                                    <StackPanel Margin="12">
                                        <TextBlock x:Name="TaskContextTextBlock" Text="请选择任务查看上下文。" Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,0,0,10" />
                                        <TextBlock x:Name="TaskBindingTextBlock" Text="-" Foreground="#94A3B8" TextWrapping="Wrap" />
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Grid.Column="1" Header="测量分析摘要" Margin="9,0,0,0" Foreground="White" BorderBrush="#334155">
                                    <StackPanel Margin="12">
                                        <TextBlock x:Name="MeasurementOverviewTextBlock" Text="请选择记录查看分析摘要。" Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,0,0,10" />
                                        <TextBlock x:Name="MeasurementDetailTextBlock" Text="-" Foreground="#94A3B8" TextWrapping="Wrap" />
                                    </StackPanel>
                                </GroupBox>
                            </Grid>

                            <DataGrid x:Name="MeasurementRecordGrid"
                                      Grid.Row="2"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Background="#0F172A"
                                      Foreground="White"
                                      BorderBrush="#334155"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      SelectionChanged="MeasurementRecordGrid_OnSelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="任务ID" Binding="{Binding TaskId}" Width="220" />
                                    <DataGridTextColumn Header="序号" Binding="{Binding RecordNo}" Width="70" />
                                    <DataGridTextColumn Header="类型" Binding="{Binding RecordType}" Width="90" />
                                    <DataGridTextColumn Header="综合色差" Binding="{Binding TotalDeltaE}" Width="100" />
                                    <DataGridTextColumn Header="效果差" Binding="{Binding TotalEffectDiff}" Width="100" />
                                    <DataGridTextColumn Header="判定" Binding="{Binding PassStatus}" Width="90" />
                                    <DataGridTextColumn Header="测量时间" Binding="{Binding MeasuredAt}" Width="180" />
                                    <DataGridTextColumn Header="摘要" Binding="{Binding ResultSummary}" Width="260" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Grid.Row="3" Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <GroupBox Header="角度结果" Margin="0,0,9,0" Foreground="White" BorderBrush="#334155">
                                    <DataGrid x:Name="AngleResultGrid"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              Background="#0F172A"
                                              Foreground="White"
                                              BorderBrush="#334155"
                                              HeadersVisibility="Column"
                                              CanUserAddRows="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="角度" Binding="{Binding AngleCode}" Width="100" />
                                            <DataGridTextColumn Header="L*" Binding="{Binding CieL}" Width="70" />
                                            <DataGridTextColumn Header="a*" Binding="{Binding CieA}" Width="70" />
                                            <DataGridTextColumn Header="b*" Binding="{Binding CieB}" Width="70" />
                                            <DataGridTextColumn Header="ΔE" Binding="{Binding DeltaE}" Width="70" />
                                            <DataGridTextColumn Header="判定" Binding="{Binding PassStatus}" Width="80" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </GroupBox>
                                <GroupBox Grid.Column="1" Header="效果结果" Margin="9,0,0,0" Foreground="White" BorderBrush="#334155">
                                    <DataGrid x:Name="EffectResultGrid"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              Background="#0F172A"
                                              Foreground="White"
                                              BorderBrush="#334155"
                                              HeadersVisibility="Column"
                                              CanUserAddRows="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="角度" Binding="{Binding AngleCode}" Width="90" />
                                            <DataGridTextColumn Header="Sparkle" Binding="{Binding SparkleValue}" Width="80" />
                                            <DataGridTextColumn Header="差值" Binding="{Binding SparkleDiff}" Width="80" />
                                            <DataGridTextColumn Header="Graininess" Binding="{Binding GraininessValue}" Width="90" />
                                            <DataGridTextColumn Header="差值" Binding="{Binding GraininessDiff}" Width="80" />
                                            <DataGridTextColumn Header="判定" Binding="{Binding EffectPassStatus}" Width="80" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </GroupBox>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="报告中心">
                    <Grid Margin="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1.15*" />
                            <RowDefinition Height="1.05*" />
                        </Grid.RowDefinitions>
                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="导出选中记录" Width="130" Height="40" Margin="0,0,10,0" Background="#F97316" Foreground="White" BorderBrush="#F97316" Click="ExportReportButton_OnClick" />
                            <Button Content="打开导出目录" Width="130" Height="40" Margin="0,0,10,0" Background="#475569" Foreground="White" BorderBrush="#475569" Click="OpenReportFolderButton_OnClick" />
                            <Button Content="打开选中报告" Width="130" Height="40" Margin="0,0,10,0" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" Click="OpenSelectedReportButton_OnClick" />
                            <TextBlock Text="报告编号" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="12,0,8,0" />
                            <TextBox x:Name="ReportFilterTextBox" Width="150" Margin="0,0,10,0" />
                            <TextBlock Text="日志模块" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="OperationLogFilterTextBox" Width="120" Margin="0,0,10,0" />
                            <Button Content="筛选" Width="70" Height="34" Margin="0,0,10,0" Background="#475569" Foreground="White" BorderBrush="#475569" Click="ApplyReportFilterButton_OnClick" />
                            <Button Content="清空" Width="70" Height="34" Background="#334155" Foreground="White" BorderBrush="#334155" Click="ClearReportFilterButton_OnClick" />
                        </WrapPanel>
                        <DataGrid x:Name="ReportExportGrid"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Background="#0F172A"
                                  Foreground="White"
                                  BorderBrush="#334155"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  SelectionChanged="ReportExportGrid_OnSelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="报告编号" Binding="{Binding ReportCode}" Width="180" />
                                <DataGridTextColumn Header="记录ID" Binding="{Binding RecordId}" Width="220" />
                                <DataGridTextColumn Header="格式" Binding="{Binding FileFormat}" Width="80" />
                                <DataGridTextColumn Header="路径" Binding="{Binding FilePath}" Width="420" />
                                <DataGridTextColumn Header="导出时间" Binding="{Binding ExportedAt}" Width="180" />
                                <DataGridTextColumn Header="状态" Binding="{Binding ExportStatus}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Row="2" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="0.95*" />
                            </Grid.ColumnDefinitions>
                            <GroupBox Header="操作日志" Margin="0,0,9,0" Foreground="White" BorderBrush="#334155">
                                <DataGrid x:Name="OperationLogGrid"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          Background="#0F172A"
                                          Foreground="White"
                                          BorderBrush="#334155"
                                          HeadersVisibility="Column"
                                          CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="模块" Binding="{Binding ModuleName}" Width="100" />
                                        <DataGridTextColumn Header="操作" Binding="{Binding OperationType}" Width="100" />
                                        <DataGridTextColumn Header="描述" Binding="{Binding OperationDesc}" Width="320" />
                                        <DataGridTextColumn Header="结果" Binding="{Binding OperationResult}" Width="100" />
                                        <DataGridTextColumn Header="时间" Binding="{Binding CreatedAt}" Width="180" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                            <GroupBox Grid.Column="1" Header="报告预览" Margin="9,0,0,0" Foreground="White" BorderBrush="#334155">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="ReportMetaTextBlock" Text="请选择一条导出记录查看报告内容。" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <TextBlock x:Name="ReportPathTextBlock" Grid.Row="1" Text="-" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,12" />
                                    <TextBox x:Name="ReportPreviewTextBox"
                                             Grid.Row="2"
                                             Background="#020617"
                                             Foreground="#E2E8F0"
                                             BorderBrush="#1E293B"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             AcceptsReturn="True" />
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>

            <Border Grid.Row="3" Background="#101B33" CornerRadius="20" BorderBrush="#334155" BorderThickness="1">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="运行日志" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBox x:Name="LogTextBox"
                             Grid.Row="1"
                             Background="#0F172A"
                             Foreground="#E2E8F0"
                             BorderBrush="#334155"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             AcceptsReturn="True" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#0B1225">
            <TextBlock Text="MAS V1 / 当前阶段：数据库初始化 + 主数据录入 + 任务草稿 + 标准样/试样测量流程" Foreground="#94A3B8" VerticalAlignment="Center" Margin="20,0" />
        </Border>
    </Grid>
</Window>

















