                            <DataGridTemplateColumn x:Name="MainColumnSimulatedColor" Header="仿真色" Width="74">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="36" Height="18" Background="{Binding SimulatedColorBrush}" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:Name="MainColumnTime" Header="时间" Binding="{Binding TimeText}" Width="170" />
                            <DataGridTextColumn x:Name="MainColumnLStar" Header="L*" Binding="{Binding LStar, StringFormat=F2}" Width="60" />
                            <DataGridTextColumn x:Name="MainColumnAStar" Header="a*" Binding="{Binding AStar, StringFormat=F2}" Width="60" />
                            <DataGridTextColumn x:Name="MainColumnBStar" Header="b*" Binding="{Binding BStar, StringFormat=F2}" Width="60" />
                            <DataGridTextColumn x:Name="MainColumnCStar" Header="C*" Binding="{Binding CStar, StringFormat=F2}" Width="60" />
