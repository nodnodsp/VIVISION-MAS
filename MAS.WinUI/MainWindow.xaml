                            <TextBlock Text="型号" Margin="0,10,0,4" />
                            <TextBox x:Name="InstrumentModelTextBox" IsReadOnly="True" />
                            <TextBlock Text="连接方式" Margin="0,10,0,4" />
                            <TextBox x:Name="InstrumentConnectionTypeTextBox" IsReadOnly="True" />
                            <TextBlock Text="端口" Margin="0,10,0,4" />
                            <TextBox x:Name="InstrumentPortTextBox" IsReadOnly="True" />
                            <TextBlock Text="状态" Margin="0,10,0,4" />
                            <TextBox x:Name="InstrumentStatusTextBox" IsReadOnly="True" />
