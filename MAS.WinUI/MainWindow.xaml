<Window x:Class="MAS.WinUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="MAS V1 多角度测色仪工作台"
        Height="940"
        Width="1480"
        MinWidth="1280"
        MinHeight="820"
        Loaded="MainWindow_OnLoaded"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#F3F4F6">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="ShellMenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style x:Key="ToolbarActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="96" />
            <Setter Property="Height" Value="68" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ToolbarChrome" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToolbarChrome" Property="Background" Value="#EEF2FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ToolbarChrome" Property="Background" Value="#E9E2F7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ToolbarChrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="CaptionChrome" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CaptionChrome" Property="Background" Value="#F3F4F6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CaptionChrome" Property="Background" Value="#E5E7EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MainSampleFilterButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="78" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="Foreground" Value="#111827" />
        </Style>
        <Style x:Key="MainTableHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#F5F3FB" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style x:Key="MainTableCellStyle" TargetType="{x:Type DataGridCell}">
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style x:Key="MainTableRowStyle" TargetType="{x:Type DataGridRow}">
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#A7D59F" />
                    <Setter Property="Foreground" Value="#111827" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#D1D5DB" BorderThickness="1" Background="#F3F4F6">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="74" />
            <RowDefinition Height="96" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="34" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" MouseLeftButtonDown="TopBar_OnMouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,20,0">
                        <TextBlock Text="MAS V1" FontSize="16" FontWeight="SemiBold" Foreground="#111827" />
                        <TextBlock Text=" &#x591A;&#x89D2;&#x5EA6;&#x6D4B;&#x8272;&#x4EEA;&#x5DE5;&#x4F5C;&#x53F0;" Margin="8,0,0,0" FontSize="13" Foreground="#6B7280" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource CaptionButtonStyle}" Click="MinimizeWindowButton_OnClick">
                            <TextBlock Text="&#x2014;" FontSize="14" Foreground="#374151" />
                        </Button>
                        <Button Style="{StaticResource CaptionButtonStyle}" Click="ToggleWindowStateButton_OnClick">
                            <TextBlock Text="&#x25A1;" FontSize="12" Foreground="#374151" />
                        </Button>
                        <Button Style="{StaticResource CaptionButtonStyle}" Click="CloseWindowButton_OnClick">
                            <TextBlock Text="&#x00D7;" FontSize="14" Foreground="#374151" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Menu Grid.Row="1"
                      Background="Transparent"
                      BorderThickness="0"
                      ItemContainerStyle="{StaticResource ShellMenuItemStyle}"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <MenuItem Header="&#x6587;&#x4EF6;(F)">
                        <MenuItem Header="&#x65B0;&#x5EFA;&#x9879;&#x76EE;(N)" Click="InitializeDatabaseButton_OnClick" />
                        <MenuItem Header="&#x6253;&#x5F00;&#x9879;&#x76EE;(O)" Tag="dashboard" Click="NavigationButton_OnClick" />
                        <MenuItem Header="&#x4FDD;&#x5B58;&#x9879;&#x76EE;(S)" IsEnabled="False" />
                        <MenuItem Header="&#x53E6;&#x5B58;&#x4E3A;(A)" Tag="&#x53E6;&#x5B58;&#x4E3A;" Click="ShellPlaceholderAction_OnClick" />
                        <Separator />
                        <MenuItem Header="&#x6253;&#x5370;(P)" InputGestureText="Ctrl+P" Click="OpenSelectedReportButton_OnClick" />
                        <MenuItem Header="&#x5BFC;&#x51FA;(E)" Click="ExportReportButton_OnClick" />
                        <Separator />
                        <MenuItem Header="&#x9000;&#x51FA;(X)" Click="CloseWindowMenuItem_OnClick" />
                    </MenuItem>
                    <MenuItem Header="&#x4EEA;&#x5668;(I)">
                        <MenuItem Header="&#x8FDE;&#x63A5;(C)" Click="OpenInstrumentConnectWindow_OnClick" />
                        <MenuItem Header="&#x8FDE;&#x63A5;&#x65B9;&#x5F0F;">
                            <MenuItem Header="&#x6A21;&#x62DF;&#x6A21;&#x5F0F;" Tag="&#x8FDE;&#x63A5;&#x65B9;&#x5F0F;/&#x6A21;&#x62DF;&#x6A21;&#x5F0F;" Click="ShellPlaceholderAction_OnClick" />
                            <MenuItem Header="&#x4E32;&#x53E3;&#x6A21;&#x5F0F;" Tag="&#x8FDE;&#x63A5;&#x65B9;&#x5F0F;/&#x4E32;&#x53E3;&#x6A21;&#x5F0F;" Click="ShellPlaceholderAction_OnClick" />
                            <MenuItem Header="&#x84DD;&#x7259;&#x6A21;&#x5F0F;(&#x9884;&#x7559;)" Tag="&#x8FDE;&#x63A5;&#x65B9;&#x5F0F;/&#x84DD;&#x7259;&#x6A21;&#x5F0F;" Click="ShellPlaceholderAction_OnClick" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="&#x4EEA;&#x5668;&#x4FE1;&#x606F;" Tag="&#x4EEA;&#x5668;&#x4FE1;&#x606F;" Click="ShellPlaceholderAction_OnClick" />
                        <MenuItem Header="&#x6821;&#x51C6;" Click="WhiteCalibrationButton_OnClick" />
                        <MenuItem Header="&#x6D4B;&#x91CF;&#x6807;&#x51C6;&#x6837;" Click="ExecuteStandardMeasurementButton_OnClick" />
                        <MenuItem Header="&#x6D4B;&#x91CF;&#x8BD5;&#x6837;" Click="ExecuteTrialMeasurementButton_OnClick" />
                        <MenuItem Header="&#x6D4B;&#x91CF;&#x6A21;&#x5F0F;" Tag="&#x6D4B;&#x91CF;&#x6A21;&#x5F0F;" Click="ShellPlaceholderAction_OnClick" />
                        <Separator />
                        <MenuItem Header="&#x4EEA;&#x5668;&#x6570;&#x636E;&#x7BA1;&#x7406;" Tag="instrument" Click="NavigationButton_OnClick" />
                        <Separator />
                        <MenuItem Header="&#x65AD;&#x5F00;&#x8FDE;&#x63A5;(D)" Click="DisconnectInstrumentButton_OnClick" />
                    </MenuItem>
                    <MenuItem Header="&#x8272;&#x5E93;&#x7BA1;&#x7406;">
                        <MenuItem Header="&#x7BA1;&#x7406;&#x8272;&#x5E93;..." Tag="standard" Click="NavigationButton_OnClick" />
                        <MenuItem Header="&#x989C;&#x8272;&#x5F55;&#x5165;..." Tag="sample" Click="NavigationButton_OnClick" />
                    </MenuItem>
                    <MenuItem Header="&#x8BBE;&#x7F6E;">
                        <MenuItem Header="&#x9ED8;&#x8BA4;&#x5149;&#x6E90;/&#x89C2;&#x5BDF;&#x8005;" Click="OpenLightSourceObserverSettings_OnClick" />
                        <MenuItem Header="&#x5149;&#x6E90;&#x8BBE;&#x7F6E;" Click="OpenLightSourceObserverSettings_OnClick" />
                        <Separator />
                        <MenuItem Header="&#x9ED8;&#x8BA4;&#x5BB9;&#x5DEE;" Click="OpenToleranceSettings_OnClick" />
                        <MenuItem Header="&#x5BB9;&#x5DEE;&#x8BBE;&#x7F6E;" Click="OpenToleranceSettings_OnClick" />
                        <Separator />
                        <MenuItem Header="&#x9ED8;&#x8BA4;&#x663E;&#x793A;&#x6570;&#x636E;&#x9879;" Click="OpenDisplaySettings_OnClick" />
                        <MenuItem Header="&#x663E;&#x793A;&#x7684;&#x6570;&#x636E;&#x9879;" Click="OpenDisplaySettings_OnClick" />
                        <MenuItem Header="&#x81EA;&#x52A8;&#x547D;&#x540D;&#x8BBE;&#x7F6E;" Tag="&#x81EA;&#x52A8;&#x547D;&#x540D;&#x8BBE;&#x7F6E;" Click="ShellPlaceholderAction_OnClick" />
                        <Separator />
                        <MenuItem Header="&#x8BED;&#x8A00;" Tag="&#x8BED;&#x8A00;" Click="ShellPlaceholderAction_OnClick" />
                        <MenuItem Header="&#x4E3B;&#x9898;" Tag="&#x4E3B;&#x9898;" Click="ShellPlaceholderAction_OnClick" />
                    </MenuItem>
                    <MenuItem Header="&#x5173;&#x4E8E;">
                        <MenuItem Header="&#x4F7F;&#x7528;&#x8BF4;&#x660E;" Tag="&#x5E2E;&#x52A9;" Click="ShellPlaceholderAction_OnClick" />
                        <MenuItem Header="&#x5173;&#x4E8E;&#x8F6F;&#x4EF6;" Tag="&#x5173;&#x4E8E;" Click="ShellPlaceholderAction_OnClick" />
                    </MenuItem>
                </Menu>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Margin="14,10,14,10">
                    <Button Style="{StaticResource ToolbarActionButtonStyle}" Click="InitializeDatabaseButton_OnClick">
                        <StackPanel>
                            <TextBlock Text="✚" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="新建项目" Margin="0,6,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarActionButtonStyle}" Tag="dashboard" Click="NavigationButton_OnClick">
                        <StackPanel>
                            <TextBlock Text="☷" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="打开项目" Margin="0,6,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarActionButtonStyle}" IsEnabled="False" Foreground="#9CA3AF">
                        <StackPanel>
                            <TextBlock Text="⬒" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="保存项目" Margin="0,6,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="56" Background="#E5E7EB" Margin="10,6,14,6" />
                    <Button Style="{StaticResource ToolbarActionButtonStyle}" Click="WhiteCalibrationButton_OnClick">
                        <StackPanel>
                            <TextBlock Text="◎" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="校准" Margin="0,6,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarActionButtonStyle}" Click="ExecuteStandardMeasurementButton_OnClick">
                        <StackPanel>
                            <TextBlock Text="◉" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="测量标准" Margin="0,6,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarActionButtonStyle}" Click="ExecuteTrialMeasurementButton_OnClick">
                        <StackPanel>
                            <TextBlock Text="◌" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="测量试样" Margin="0,6,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="56" Background="#E5E7EB" Margin="10,6,14,6" />
                    <Button Style="{StaticResource ToolbarActionButtonStyle}" Tag="measurement_center" Click="NavigationButton_OnClick">
                        <StackPanel>
                            <TextBlock Text="▦" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="测量中心" Margin="0,6,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarActionButtonStyle}" Tag="measurement_analysis" Click="NavigationButton_OnClick">
                        <StackPanel>
                            <TextBlock Text="≣" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="结果分析" Margin="0,6,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarActionButtonStyle}" Tag="standard" Click="NavigationButton_OnClick">
                        <StackPanel>
                            <TextBlock Text="◫" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="色库管理" Margin="0,6,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarActionButtonStyle}" Tag="sample" Click="NavigationButton_OnClick">
                        <StackPanel>
                            <TextBlock Text="☰" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="样品管理" Margin="0,6,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarActionButtonStyle}" Tag="template" Click="NavigationButton_OnClick">
                        <StackPanel>
                            <TextBlock Text="⌘" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="容差设置" Margin="0,6,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="56" Background="#E5E7EB" Margin="10,6,14,6" />
                    <Button Style="{StaticResource ToolbarActionButtonStyle}" Click="OpenSelectedReportButton_OnClick">
                        <StackPanel>
                            <TextBlock Text="⎙" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="打印" Margin="0,6,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarActionButtonStyle}" Click="ExportReportButton_OnClick">
                        <StackPanel>
                            <TextBlock Text="⇩" FontSize="20" HorizontalAlignment="Center" />
                            <TextBlock Text="导出" Margin="0,6,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Grid.Column="0" Margin="12,12,10,12" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="#F9FAFB" BorderBrush="#D1D5DB" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                        <TextBlock Text="📁" FontSize="16" Margin="0,0,8,0" />
                        <TextBlock Text="项目浏览器" Foreground="#111827" FontSize="14" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="1" Margin="8,8,8,10">
                    <Grid Margin="6,2,6,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁" Margin="0,0,8,0" FontSize="16" />
                            <TextBlock Text="Project001" Foreground="#111827" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="2026-03-25" Foreground="#6B7280" FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                    <Border Background="#EEE8FA" BorderBrush="#D8CCF2" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8">
                        <Grid Margin="12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◉" Foreground="#7C3AED" FontSize="16" Margin="0,0,8,0" />
                                <TextBlock Text="粗糙面" Foreground="#111827" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="2026-03-25 10:48:55" Foreground="#4B5563" FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Background="Transparent" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6">
                        <Grid Margin="12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◌" Foreground="#7C3AED" FontSize="16" Margin="0,0,8,0" />
                                <TextBlock Text="光滑面" Foreground="#111827" FontSize="14" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="2026-03-25 10:49:47" Foreground="#6B7280" FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Grid.Column="1" Margin="0,12,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="120" />
                <RowDefinition Height="120" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="150" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Grid.RowSpan="4" Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="10">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="颜色数据表" FontSize="22" FontWeight="SemiBold" Foreground="#1F2937" />
                            <TextBlock Text="按名称、角度、光源、观察者与 Lab 结果展示当前颜色数据。" Margin="0,8,0,0" FontSize="13" Foreground="#6B7280" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#F5F3FB" BorderBrush="#D8CCF2" BorderThickness="1" CornerRadius="16" Padding="14,8" VerticalAlignment="Center">
                            <TextBlock x:Name="MainSampleCountTextBlock" Text="共 0 条数据" Foreground="#5B21B6" FontSize="13" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,14,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#2EA43A" CornerRadius="14,14,0,0" Padding="18,8" Margin="0,0,6,0">
                                <TextBlock Text="颜色" Foreground="White" FontWeight="SemiBold" />
                            </Border>
                            <Border Background="#F3F4F6" CornerRadius="14,14,0,0" Padding="18,8" Margin="0,0,6,0">
                                <TextBlock Text="效果色" Foreground="#6B7280" FontWeight="SemiBold" />
                            </Border>
                            <Border Background="#F3F4F6" CornerRadius="14,14,0,0" Padding="18,8" Margin="0,0,6,0">
                                <TextBlock Text="光谱图" Foreground="#6B7280" FontWeight="SemiBold" />
                            </Border>
                            <Border Background="#F3F4F6" CornerRadius="14,14,0,0" Padding="18,8">
                                <TextBlock Text="Lab Plot" Foreground="#6B7280" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <Border Margin="0,0,0,12" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12,10">
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="关键字" Margin="0,8,8,0" Foreground="#4B5563" />
                                <TextBox x:Name="MainSampleFilterTextBox" Width="220" Height="32" Margin="0,0,12,0" VerticalContentAlignment="Center" />
                                <TextBlock Text="类型" Margin="0,8,8,0" Foreground="#4B5563" />
                                <ComboBox x:Name="MainSampleStatusFilterComboBox" Width="130" Height="32" SelectedIndex="0" Margin="0,0,12,0">
                                    <ComboBoxItem Content="全部" />
                                    <ComboBoxItem Content="standard" />
                                    <ComboBoxItem Content="trial" />
                                </ComboBox>
                                <Button Style="{StaticResource MainSampleFilterButtonStyle}" Content="筛选" Click="ApplyMainSampleFilterButton_OnClick" />
                                <Button Style="{StaticResource MainSampleFilterButtonStyle}" Content="清空" Click="ClearMainSampleFilterButton_OnClick" />
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                    <Border Grid.Row="2" Margin="0,0,0,14" Background="#FAF8FF" BorderBrush="#E9E0F7" BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <TextBlock x:Name="MainSampleSelectionTextBlock" Text="当前未选中颜色数据。" FontSize="13" Foreground="#4B5563" />
                    </Border>
                    <DataGrid x:Name="MainSampleDisplayGrid"
                              Grid.Row="3"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="#FFFFFF"
                              Foreground="#111827"
                              BorderBrush="#D1D5DB"
                              HeadersVisibility="Column"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#FBF9FE"
                              RowBackground="#FFFFFF"
                              ColumnHeaderStyle="{StaticResource MainTableHeaderStyle}"
                              CellStyle="{StaticResource MainTableCellStyle}"
                              RowStyle="{StaticResource MainTableRowStyle}"
