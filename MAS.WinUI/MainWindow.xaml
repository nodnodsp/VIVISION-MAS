                </TabItem>
<TabItem Header="测量记录">
                    <Grid Margin="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,18,0">
                            <StackPanel>
                                <TextBlock Text="测量流程" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <TextBlock Text="任务编号" Margin="0,6,0,4" />
                                <TextBox x:Name="RecordTaskCodeTextBox" />
                                <TextBlock Text="记录序号" Margin="0,10,0,4" />
                                <TextBox x:Name="RecordNoTextBox" Text="1" />
                                <TextBlock Text="记录类型" Margin="0,10,0,4" />
                                <TextBox x:Name="RecordTypeTextBox" Text="trial" />
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="执行标准样测量" Width="150" Height="40" Margin="0,0,10,10" Background="#22C55E" Foreground="White" BorderBrush="#22C55E" Click="ExecuteStandardMeasurementButton_OnClick" />
                                    <Button Content="执行试样测量" Width="150" Height="40" Margin="0,0,10,10" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" Click="ExecuteTrialMeasurementButton_OnClick" />
                                </WrapPanel>
                                <TextBlock Text="也可使用下面表单进行手工补录。" Foreground="#94A3B8" Margin="0,2,0,8" TextWrapping="Wrap" />
                                <TextBlock Text="综合色差" Margin="0,10,0,4" />
                                <TextBox x:Name="RecordTotalDeltaETextBox" Text="0.68" />
                                <TextBlock Text="效果差" Margin="0,10,0,4" />
                                <TextBox x:Name="RecordTotalEffectDiffTextBox" Text="0.32" />
                                <TextBlock Text="判定结果" Margin="0,10,0,4" />
                                <ComboBox x:Name="RecordPassStatusComboBox" SelectedIndex="0">
                                    <ComboBoxItem Content="Pass" />
                                    <ComboBoxItem Content="Warning" />
                                    <ComboBoxItem Content="Fail" />
                                </ComboBox>
                                <TextBlock Text="摘要说明" Margin="0,10,0,4" />
                                <TextBox x:Name="RecordSummaryTextBox" Text="测量结果处于容差范围内。" TextWrapping="Wrap" AcceptsReturn="True" Height="60" />

                                <Separator Margin="0,16,0,16" />
                                <TextBlock Text="角度结果" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="角度代码" Margin="0,10,0,4" />
                                <TextBox x:Name="RecordAngleCodeTextBox" Text="45as110" />
                                <TextBlock Text="L*" Margin="0,10,0,4" />
                                <TextBox x:Name="RecordCieLTextBox" Text="63.14" />
                                <TextBlock Text="a*" Margin="0,10,0,4" />
                                <TextBox x:Name="RecordCieATextBox" Text="-1.04" />
                                <TextBlock Text="b*" Margin="0,10,0,4" />
                                <TextBox x:Name="RecordCieBTextBox" Text="-3.18" />
                                <TextBlock Text="角度色差 ΔE" Margin="0,10,0,4" />
                                <TextBox x:Name="RecordAngleDeltaETextBox" Text="0.81" />

                                <Separator Margin="0,16,0,16" />
                                <TextBlock Text="效果结果" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Sparkle" Margin="0,10,0,4" />
                                <TextBox x:Name="RecordSparkleValueTextBox" Text="4.12" />
                                <TextBlock Text="Sparkle 差值" Margin="0,10,0,4" />
                                <TextBox x:Name="RecordSparkleDiffTextBox" Text="0.18" />
                                <TextBlock Text="Graininess" Margin="0,10,0,4" />
                                <TextBox x:Name="RecordGraininessValueTextBox" Text="2.06" />
                                <TextBlock Text="Graininess 差值" Margin="0,10,0,4" />
                                <TextBox x:Name="RecordGraininessDiffTextBox" Text="0.14" />
                                <WrapPanel Margin="0,18,0,0">
                                    <Button Content="保存手工记录" Width="150" Height="40" Margin="0,0,10,10" Background="#14B8A6" Foreground="White" BorderBrush="#14B8A6" Click="SaveMeasurementRecordButton_OnClick" />
                                    <Button Content="导出当前报告" Width="150" Height="40" Margin="0,0,10,10" Background="#F97316" Foreground="White" BorderBrush="#F97316" Click="ExportReportButton_OnClick" />
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1.55*" />
                                <RowDefinition Height="1.05*" />
                            </Grid.RowDefinitions>

                            <WrapPanel Margin="0,0,0,12">
                                <TextBlock Text="任务编号" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="RecordFilterTaskCodeTextBox" Width="140" Margin="0,0,10,0" />
                                <TextBlock Text="记录类型" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="RecordFilterTypeComboBox" Width="110" SelectedIndex="0" Margin="0,0,10,0">
                                    <ComboBoxItem Content="全部" />
                                    <ComboBoxItem Content="standard" />
                                    <ComboBoxItem Content="trial" />
                                </ComboBox>
                                <Button Content="筛选记录" Width="90" Height="34" Margin="0,0,10,0" Background="#475569" Foreground="White" BorderBrush="#475569" Click="ApplyRecordFilterButton_OnClick" />
                                <Button Content="清空" Width="70" Height="34" Background="#334155" Foreground="White" BorderBrush="#334155" Click="ClearRecordFilterButton_OnClick" />
                            </WrapPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <GroupBox Header="任务上下文" Margin="0,0,9,0" Foreground="White" BorderBrush="#334155">
                                    <StackPanel Margin="12">
                                        <TextBlock x:Name="TaskContextTextBlock" Text="请选择任务查看上下文。" Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,0,0,10" />
                                        <TextBlock x:Name="TaskBindingTextBlock" Text="-" Foreground="#94A3B8" TextWrapping="Wrap" />
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Grid.Column="1" Header="测量分析摘要" Margin="9,0,0,0" Foreground="White" BorderBrush="#334155">
                                    <StackPanel Margin="12">
                                        <TextBlock x:Name="MeasurementOverviewTextBlock" Text="请选择记录查看分析摘要。" Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,0,0,10" />
                                        <TextBlock x:Name="MeasurementDetailTextBlock" Text="-" Foreground="#94A3B8" TextWrapping="Wrap" />
                                    </StackPanel>
                                </GroupBox>
                            </Grid>

                            <DataGrid x:Name="MeasurementRecordGrid"
                                      Grid.Row="2"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Background="#F3F4F6"
                                      Foreground="White"
                                      BorderBrush="#334155"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      SelectionChanged="MeasurementRecordGrid_OnSelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="任务ID" Binding="{Binding TaskId}" Width="220" />
                                    <DataGridTextColumn Header="序号" Binding="{Binding RecordNo}" Width="70" />
                                    <DataGridTextColumn Header="类型" Binding="{Binding RecordType}" Width="90" />
                                    <DataGridTextColumn Header="综合色差" Binding="{Binding TotalDeltaE}" Width="100" />
                                    <DataGridTextColumn Header="效果差" Binding="{Binding TotalEffectDiff}" Width="100" />
                                    <DataGridTextColumn Header="判定" Binding="{Binding PassStatus}" Width="90" />
                                    <DataGridTextColumn Header="测量时间" Binding="{Binding MeasuredAt}" Width="180" />
                                    <DataGridTextColumn Header="摘要" Binding="{Binding ResultSummary}" Width="260" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Grid.Row="3" Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <GroupBox Header="角度结果" Margin="0,0,9,0" Foreground="White" BorderBrush="#334155">
                                    <DataGrid x:Name="AngleResultGrid"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              Background="#F3F4F6"
                                              Foreground="White"
                                              BorderBrush="#334155"
                                              HeadersVisibility="Column"
                                              CanUserAddRows="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="角度" Binding="{Binding AngleCode}" Width="100" />
                                            <DataGridTextColumn Header="L*" Binding="{Binding CieL}" Width="70" />
                                            <DataGridTextColumn Header="a*" Binding="{Binding CieA}" Width="70" />
                                            <DataGridTextColumn Header="b*" Binding="{Binding CieB}" Width="70" />
                                            <DataGridTextColumn Header="ΔE" Binding="{Binding DeltaE}" Width="70" />
                                            <DataGridTextColumn Header="判定" Binding="{Binding PassStatus}" Width="80" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </GroupBox>
                                <GroupBox Grid.Column="1" Header="效果结果" Margin="9,0,0,0" Foreground="White" BorderBrush="#334155">
                                    <DataGrid x:Name="EffectResultGrid"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              Background="#F3F4F6"
                                              Foreground="White"
                                              BorderBrush="#334155"
                                              HeadersVisibility="Column"
                                              CanUserAddRows="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="角度" Binding="{Binding AngleCode}" Width="90" />
                                            <DataGridTextColumn Header="Sparkle" Binding="{Binding SparkleValue}" Width="80" />
                                            <DataGridTextColumn Header="差值" Binding="{Binding SparkleDiff}" Width="80" />
                                            <DataGridTextColumn Header="Graininess" Binding="{Binding GraininessValue}" Width="90" />
                                            <DataGridTextColumn Header="差值" Binding="{Binding GraininessDiff}" Width="80" />
                                            <DataGridTextColumn Header="判定" Binding="{Binding EffectPassStatus}" Width="80" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </GroupBox>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="报告中心">
                    <Grid Margin="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1.15*" />
                            <RowDefinition Height="1.05*" />
                        </Grid.RowDefinitions>
                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="导出选中记录" Width="130" Height="40" Margin="0,0,10,0" Background="#F97316" Foreground="White" BorderBrush="#F97316" Click="ExportReportButton_OnClick" />
                            <Button Content="打开导出目录" Width="130" Height="40" Margin="0,0,10,0" Background="#475569" Foreground="White" BorderBrush="#475569" Click="OpenReportFolderButton_OnClick" />
                            <Button Content="打开选中报告" Width="130" Height="40" Margin="0,0,10,0" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" Click="OpenSelectedReportButton_OnClick" />
                            <TextBlock Text="导出格式" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="12,0,8,0" />
                            <ComboBox x:Name="ReportFormatComboBox" Width="120" SelectedIndex="0" Margin="0,0,10,0">
                                <ComboBoxItem Content="md" />
                                <ComboBoxItem Content="html" />
                                <ComboBoxItem Content="csv" />
                            </ComboBox>
                            <TextBlock Text="报告编号" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="12,0,8,0" />
                            <TextBox x:Name="ReportFilterTextBox" Width="150" Margin="0,0,10,0" />
                            <TextBlock Text="日志模块" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="OperationLogFilterTextBox" Width="120" Margin="0,0,10,0" />
                            <TextBlock Text="报文类型" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="PacketFilterTextBox" Width="120" Margin="0,0,10,0" />
                            <Button Content="筛选" Width="70" Height="34" Margin="0,0,10,0" Background="#475569" Foreground="White" BorderBrush="#475569" Click="ApplyReportFilterButton_OnClick" />
                            <Button Content="清空" Width="70" Height="34" Background="#334155" Foreground="White" BorderBrush="#334155" Click="ClearReportFilterButton_OnClick" />
                        </WrapPanel>
                        <DataGrid x:Name="ReportExportGrid"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Background="#F3F4F6"
                                  Foreground="White"
                                  BorderBrush="#334155"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  SelectionChanged="ReportExportGrid_OnSelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="报告编号" Binding="{Binding ReportCode}" Width="180" />
                                <DataGridTextColumn Header="记录ID" Binding="{Binding RecordId}" Width="220" />
                                <DataGridTextColumn Header="格式" Binding="{Binding FileFormat}" Width="80" />
                                <DataGridTextColumn Header="路径" Binding="{Binding FilePath}" Width="420" />
                                <DataGridTextColumn Header="导出时间" Binding="{Binding ExportedAt}" Width="180" />
                                <DataGridTextColumn Header="状态" Binding="{Binding ExportStatus}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Row="2" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="0.95*" />
                            </Grid.ColumnDefinitions>
                            <GroupBox Header="历史日志" Margin="0,0,9,0" Foreground="White" BorderBrush="#334155">
                                <TabControl Background="#F3F4F6" BorderBrush="#334155" Foreground="White">
                                    <TabItem Header="操作日志">
                                        <DataGrid x:Name="OperationLogGrid"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  Background="#F3F4F6"
                                                  Foreground="White"
                                                  BorderBrush="#334155"
                                                  HeadersVisibility="Column"
                                                  CanUserAddRows="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="模块" Binding="{Binding ModuleName}" Width="100" />
                                                <DataGridTextColumn Header="操作" Binding="{Binding OperationType}" Width="100" />
                                                <DataGridTextColumn Header="描述" Binding="{Binding OperationDesc}" Width="320" />
                                                <DataGridTextColumn Header="结果" Binding="{Binding OperationResult}" Width="100" />
                                                <DataGridTextColumn Header="时间" Binding="{Binding CreatedAt}" Width="180" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>
                                    <TabItem Header="通讯报文">
                                        <DataGrid x:Name="RawPacketGrid"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  Background="#F3F4F6"
                                                  Foreground="White"
                                                  BorderBrush="#334155"
                                                  HeadersVisibility="Column"
                                                  CanUserAddRows="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="方向" Binding="{Binding Direction}" Width="90" />
                                                <DataGridTextColumn Header="类型" Binding="{Binding PacketType}" Width="160" />
                                                <DataGridTextColumn Header="任务/仪器" Binding="{Binding TaskId}" Width="180" />
                                                <DataGridTextColumn Header="仪器ID" Binding="{Binding InstrumentId}" Width="180" />
                                                <DataGridTextColumn Header="报文文本" Binding="{Binding PacketText}" Width="360" />
                                                <DataGridTextColumn Header="时间" Binding="{Binding CreatedAt}" Width="180" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>
                                </TabControl>
                            </GroupBox>
                            <GroupBox Grid.Column="1" Header="报告预览" Margin="9,0,0,0" Foreground="White" BorderBrush="#334155">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="ReportMetaTextBlock" Text="请选择一条导出记录查看报告内容。" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <TextBlock x:Name="ReportPathTextBlock" Grid.Row="1" Text="-" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,12" />
                                    <TextBox x:Name="ReportPreviewTextBox"
                                             Grid.Row="2"
                                             Background="#020617"
                                             Foreground="#E2E8F0"
                                             BorderBrush="#1E293B"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             AcceptsReturn="True" />
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="系统设置">
                    <Grid Margin="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="系统设置" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <TextBlock Text="默认任务类型" Margin="0,6,0,4" />
                            <ComboBox x:Name="SettingsTaskTypeComboBox" SelectedIndex="0">
                                <ComboBoxItem Content="trial" />
                                <ComboBoxItem Content="standard" />
                            </ComboBox>
                            <TextBlock Text="默认测量模式" Margin="0,10,0,4" />
                            <ComboBox x:Name="SettingsMeasurementModeComboBox" SelectedIndex="0">
                                <ComboBoxItem Content="Single" />
                                <ComboBoxItem Content="Average" />
                                <ComboBoxItem Content="Continuous" />
                            </ComboBox>
                            <TextBlock Text="默认平均次数" Margin="0,10,0,4" />
                            <TextBox x:Name="SettingsAverageCountTextBox" Text="1" />
                            <TextBlock Text="默认测量间隔（秒）" Margin="0,10,0,4" />
                            <TextBox x:Name="SettingsIntervalSecondsTextBox" Text="5" />
                            <TextBlock Text="默认模板编号" Margin="0,10,0,4" />
                            <TextBox x:Name="SettingsTemplateCodeTextBox" Text="TPL-DEFAULT" />
                            <TextBlock Text="报告预览最大字符数" Margin="0,10,0,4" />
                            <TextBox x:Name="SettingsPreviewLengthTextBox" Text="6000" />
                            <TextBlock Text="仪器运行模式" Margin="0,10,0,4" />
                            <ComboBox x:Name="SettingsRuntimeModeComboBox" SelectedIndex="0">
                                <ComboBoxItem Content="Simulated" />
                                <ComboBoxItem Content="SerialStub" />
                            </ComboBox>
                            <TextBlock Text="默认串口端口" Margin="0,10,0,4" />
                            <TextBox x:Name="SettingsInstrumentPortTextBox" Text="COM3" />
                            <TextBlock Text="串口波特率" Margin="0,10,0,4" />
                            <TextBox x:Name="SettingsInstrumentBaudRateTextBox" Text="115200" />
                            <TextBlock Text="读取超时（毫秒）" Margin="0,10,0,4" />
                            <TextBox x:Name="SettingsInstrumentTimeoutTextBox" Text="1500" />
                            <WrapPanel Margin="0,18,0,0">
                                <Button Content="保存设置" Width="120" Height="40" Margin="0,0,10,10" Background="#14B8A6" Foreground="White" BorderBrush="#14B8A6" Click="SaveSettingsButton_OnClick" />
                                <Button Content="重新加载" Width="120" Height="40" Margin="0,0,10,10" Background="#475569" Foreground="White" BorderBrush="#475569" Click="ReloadSettingsButton_OnClick" />
                                <Button Content="备份数据" Width="120" Height="40" Margin="0,0,10,10" Background="#0EA5E9" Foreground="White" BorderBrush="#0EA5E9" Click="BackupDataButton_OnClick" />
                                <Button Content="恢复最近备份" Width="120" Height="40" Margin="0,0,10,10" Background="#1D4ED8" Foreground="White" BorderBrush="#1D4ED8" Click="RestoreLatestBackupButton_OnClick" />
                                <Button Content="导出诊断包" Width="120" Height="40" Margin="0,0,10,10" Background="#F97316" Foreground="White" BorderBrush="#F97316" Click="ExportDiagnosticsButton_OnClick" />
                                <Button Content="打开备份目录" Width="120" Height="40" Margin="0,0,10,10" Background="#475569" Foreground="White" BorderBrush="#475569" Click="OpenBackupFolderButton_OnClick" />
                                <Button Content="打开数据目录" Width="120" Height="40" Margin="0,0,10,10" Background="#334155" Foreground="White" BorderBrush="#334155" Click="OpenDataFolderButton_OnClick" />
                            </WrapPanel>
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <GroupBox Header="设置摘要" Foreground="White" BorderBrush="#334155" Margin="0,0,0,16">
                                <StackPanel Margin="12">
                                    <TextBlock x:Name="SettingsSummaryTextBlock" Text="当前尚未加载系统设置。" Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <TextBlock x:Name="SettingsImpactTextBlock" Text="-" Foreground="#94A3B8" TextWrapping="Wrap" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Grid.Row="1" Header="配置文件" Foreground="White" BorderBrush="#334155" Margin="0,0,0,16">
                                <StackPanel Margin="12">
                                    <TextBlock x:Name="SettingsPathTextBlock" Text="-" Foreground="#E2E8F0" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <TextBlock x:Name="SettingsUpdatedAtTextBlock" Text="-" Foreground="#94A3B8" TextWrapping="Wrap" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Grid.Row="2" Header="生效说明" Foreground="White" BorderBrush="#334155">
                                <TextBlock Margin="12" TextWrapping="Wrap" Foreground="#CBD5E1" Text="默认任务类型、测量模式、平均次数、测量间隔会应用到新建任务草稿。默认模板编号会作为标准样录入和任务草稿的默认模板。报告预览长度会影响报告中心右侧的预览截断长度。仪器运行模式与串口参数会影响连接、校准和测量服务的运行时选择。" />
                            </GroupBox>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>

            <Border Grid.Row="3" Background="#101B33" CornerRadius="20" BorderBrush="#334155" BorderThickness="1" Visibility="Collapsed">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="运行日志" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBox x:Name="LogTextBox"
                             Grid.Row="1"
                             Background="#F3F4F6"
                             Foreground="#E2E8F0"
                             BorderBrush="#334155"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             AcceptsReturn="True" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Grid.ColumnSpan="2" Background="#C9B8EA">
            <TextBlock x:Name="FooterStatusTextBlock" Text="Ready  |  MAS V1 当前阶段：样品数据显示主视图" Foreground="White" VerticalAlignment="Center" Margin="20,0" />
        </Border>
    </Grid>
    </Border>
</Window>








































