                                    <DataGridTextColumn Header="编号" Binding="{Binding InstrumentCode}" Width="140" />
                                    <DataGridTextColumn Header="名称" Binding="{Binding InstrumentName}" Width="180" />
                                    <DataGridTextColumn Header="型号" Binding="{Binding Model}" Width="120" />
                                    <DataGridTextColumn Header="连接方式" Binding="{Binding ConnectionType}" Width="100" />
                                    <DataGridTextColumn Header="端口" Binding="{Binding PortName}" Width="100" />
                                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <DataGrid x:Name="CalibrationRecordGrid"
                                      Grid.Row="1"
                                      Margin="0,18,0,0"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      Background="#F3F4F6"
                                      Foreground="White"
                                      BorderBrush="#334155"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False">
