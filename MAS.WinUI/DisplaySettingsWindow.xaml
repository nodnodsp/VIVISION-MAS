<Window x:Class="MAS.WinUI.DisplaySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="显示设置"
        Width="900"
        Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFFFFF">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#2EA43A">
            <Grid Margin="18,0">
                <TextBlock Text="显示设置" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,18,24,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="98" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <GroupBox Header="所有数据项" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="CategoryListBox" BorderThickness="0" SelectionChanged="CategoryListBox_OnSelectionChanged" />
                    <ListBox x:Name="AvailableItemsListBox" Grid.Column="1" BorderBrush="#34B24A" BorderThickness="1" />
                </Grid>
            </GroupBox>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button Width="86" Height="36" Margin="0,0,0,12" Content=">" Click="MoveSelectedToVisible_OnClick" />
                <Button Width="86" Height="36" Margin="0,0,0,12" Content="&lt;" Click="MoveSelectedToAvailable_OnClick" />
                <Button Width="86" Height="36" Margin="0,0,0,12" Content=">>" Click="MoveAllToVisible_OnClick" />
                <Button Width="86" Height="36" Content="&lt;&lt;" Click="MoveAllToAvailable_OnClick" />
            </StackPanel>

            <GroupBox Grid.Column="2" Header="显示的数据项" Padding="8">
                <ListBox x:Name="VisibleItemsListBox" BorderBrush="#34B24A" BorderThickness="1" />
            </GroupBox>

            <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button Width="82" Height="36" Margin="0,0,0,12" Content="上移" Click="MoveUp_OnClick" />
                <Button Width="82" Height="36" Margin="0,0,0,12" Content="下移" Click="MoveDown_OnClick" />
            </StackPanel>

            <Grid Grid.Row="1" Grid.ColumnSpan="4" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="恢复到默认" Height="42" Background="#FFFFFF" BorderBrush="#D1D5DB" Click="RestoreDefaultButton_OnClick" />
                <Button Grid.Column="3" Content="接受" Height="42" Background="#FFFFFF" BorderBrush="#D1D5DB" Click="AcceptButton_OnClick" />
            </Grid>
        </Grid>
    </Grid>
</Window>

